# ── Homebox ──
# Strong random string used to hash API keys (keep secret, don't change after first run)
HBOX_AUTH_API_KEY_PEPPER=CHANGE_ME_TO_A_RANDOM_STRING

# API token for the relay to fetch labels from Homebox
# Create one in Homebox: Settings → API Keys → Create
HOMEBOX_API_TOKEN=hb_your_api_key_here

# ── Print Relay ──
# CUPS printer name for the Brother QL-800
PRINTER_NAME=Brother_QL_800
