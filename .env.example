# ── Homebox ──
# Strong random string used to hash API keys (keep secret, don't change after first run)
HBOX_AUTH_API_KEY_PEPPER=CHANGE_ME_TO_A_RANDOM_STRING

# API token for the relay to fetch labels from Homebox
# Create one in Homebox: Settings → API Keys → Create
HOMEBOX_API_TOKEN=hb_your_api_key_here

# ── Print Relay ──
# CUPS printer name for the Brother QL-800
PRINTER_NAME=QL-800

# Remote CUPS server if printer is plugged into another computer (e.g., aang: 192.168.0.186:631)
# Leave commented or empty if printer is connected directly to the Homebox machine
# CUPS_SERVER=192.168.0.186:631

# Label format (default: 62red for 62mm continuous black/red DK-2251 roll)
# Options: 62red, 62, 29x90
LABEL_TYPE=62red
PRINTER_MODEL=QL-800
